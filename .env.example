# Add at least two real provider API keys. Never commit real keys.
LLM_API_KEYS=your_provider_api_key_1,your_provider_api_key_2
# LiteLLM model identifier. Example below uses Google Gemini.
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are Lyftr AI, a helpful, accurate, and concise assistant.
LITELLM_CACHE_DIR=/data/litellm_cache
# For a hosted frontend, set this to your deployed backend URL at build time.
VITE_API_URL=http://localhost:8000
